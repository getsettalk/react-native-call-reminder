{
  "name": "react-native-call-reminder",
  "version": "0.2.0",
  "description": "Store-compliant, call-style reminders for React Native: a full-screen incoming-call screen on Android, Time Sensitive notifications on iOS, and spoken reminders via the device text-to-speech engine.",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./jest/mock": "./jest/mock.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "jest",
    "*.podspec",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/.cxx",
    "!android/.gradle",
    "!ios/build",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "build": "bob build",
    "clean": "rm -rf lib android/build android/.cxx",
    "prepack": "bob build && node ./scripts/verify-build.js"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "reminder",
    "medication",
    "alarm",
    "full-screen-intent",
    "incoming-call",
    "text-to-speech",
    "time-sensitive",
    "turbo-module"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getsettalk/react-native-call-reminder-.git"
  },
  "author": "Sujeet Kumar (https://github.com/getsettalk)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/getsettalk/react-native-call-reminder-/issues"
  },
  "homepage": "https://github.com/getsettalk/react-native-call-reminder-#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "jest": "^29.6.3",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-builder-bob": "^0.40.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.80.0"
  },
  "engines": {
    "node": ">= 20"
  },
  "jest": {
    "testEnvironment": "node",
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNCallReminderSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.callreminder"
    },
    "ios": {
      "modulesProvider": {
        "CallReminder": "CallReminder"
      }
    }
  }
}
