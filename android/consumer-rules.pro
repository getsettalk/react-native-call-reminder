# react-native-call-reminder
# Components are referenced from the merged manifest and PendingIntents; the
# TurboModule is looked up reflectively by React Native.
-keep class com.callreminder.CallReminderModule { *; }
-keep class com.callreminder.CallReminderPackage { *; }
-keep class com.callreminder.IncomingCallActivity { *; }
-keep class com.callreminder.CallActionReceiver { *; }
-keep class com.callreminder.CallReminderHeadlessService { *; }
-keep class com.callreminder.NativeCallReminderSpec { *; }
